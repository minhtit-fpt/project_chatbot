GEMINI_API_KEY=your_gemini_api_key_here
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# MySQL logging
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=chatbot
MYSQL_PASSWORD=your_password_here
