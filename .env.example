GEMINI_API_KEY=your_gemini_api_key_here
OBSIDIAN_VAULT_PATH=/root/obsidian-vault

# MySQL logging — dùng chung MySQL đang chạy trên server
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chatbot
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=chatbot_logs

# CORS — danh sách origins được phép gọi API, cách nhau bằng dấu phẩy
# Dùng * cho dev/local. Production nên set domain cụ thể của website.
# Ví dụ: ALLOWED_ORIGINS=https://dienmaythienphu.vn,https://www.dienmaythienphu.vn
ALLOWED_ORIGINS=*
