GEMINI_API_KEY=your_gemini_api_key_here
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Model để tạo embedding (thường không cần thay đổi)
EMBEDDING_MODEL=gemini-embedding-2

# Chain models dùng tuần tự khi retry — mỗi lần thử = 1 model khác.
CHAT_MODEL_CHAIN=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro,gemini-3-flash-preview,gemini-3-pro-preview
